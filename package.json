{
  "name": "proclubs-sdk",
  "version": "0.2.1",
  "description": "Unofficial TypeScript SDK for EA Sports FC Pro Clubs.",
  "author": "Alex Jordan",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@10.9.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-jordan547/proclubs-sdk.git"
  },
  "homepage": "https://github.com/alex-jordan547/proclubs-sdk#readme",
  "bugs": {
    "url": "https://github.com/alex-jordan547/proclubs-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && NODE_OPTIONS='--import tsx' oxlint .",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:compatibility": "tsx scripts/check-compatibility.ts"
  },
  "keywords": [
    "ea-sports-fc",
    "pro-clubs",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "impit": "0.14.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^22.20.1",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "tsx": "^4.23.12"
  }
}

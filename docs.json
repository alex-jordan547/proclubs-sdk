{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "proclubs-sdk",
  "description": "Unofficial EA FC Pro Clubs API SDK for TypeScript and Node.js. Club stats, player rosters, rankings and recent matches, without an EA account.",
